<?xml version="1.0" encoding="utf-8"?>
<!--
  Overlay aksen warna pilihan pengguna.

  Rantai gaya sengaja TIDAK menyentuh Theme.AniStream: induknya adalah
  theme_accent_base yang tanpa induk, sehingga overlay ini hanya mengganti
  atribut warna aksen. Karena itu gaya yang sama aman diterapkan lewat
  setTheme() di atas tema dasar mana pun (utama, seri, maupun pemutar).

  Nilai warnanya memakai @color sehingga otomatis mengikuti mode terang
  (values/colors.xml) atau gelap (values-night/colors.xml).

  Re-based tahap 2: opsi "Indigo" (bawaan) mengikuti tabel token
  Slate/Indigo di animelovers.md §4 — terang #4F46E5, gelap #818CF8, wadah
  memakai accent_soft. Tujuh opsi lain tetap dipertahankan sebagai alternatif.
-->
<resources>
    <!-- Induk kosong: memutus induk implisit agar rantai overlay tetap tipis. -->
    <style name="theme_accent_base" />

    <!-- Atribut bersama untuk semua pilihan aksen. -->
    <style name="Theme.AniStream.Accent" parent="@style/theme_accent_base">
        <item name="colorOnPrimary">@color/accent_on_primary</item>
        <item name="colorOnSecondary">@color/accent_on_primary</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
    </style>

    <!-- 1. Indigo — bawaan. -->
    <style name="Theme.AniStream.Accent.Indigo">
        <item name="colorPrimary">@color/accent_indigo</item>
        <item name="colorPrimaryContainer">@color/accent_container_indigo</item>
        <item name="colorSecondary">@color/accent_indigo</item>
        <item name="colorSecondaryContainer">@color/accent_container_indigo</item>
        <item name="colorAccent">@color/accent_indigo</item>
        <item name="android:colorAccent">@color/accent_indigo</item>
        <item name="colorControlActivated">@color/accent_indigo</item>
    </style>

    <!-- 2. Ungu. -->
    <style name="Theme.AniStream.Accent.Ungu">
        <item name="colorPrimary">@color/accent_ungu</item>
        <item name="colorPrimaryContainer">@color/accent_container_ungu</item>
