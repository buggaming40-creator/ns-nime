<?xml version="1.0" encoding="utf-8"?>
<!--
  Kontrol khusus ExoPlayer/Media3 untuk NsNime - ala YouTube/AnimeLovers:
  Kluster TENGAH: prev / putar-jeda besar / next - TERPISAH dari bar durasi.
  Bar BAWAH: pil kaca berisi posisi + progres + durasi saja.
  Bilah atas TIDAK di sini - memakai topbar overlay sendiri (activity_player).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Penyangga buffering ditangani PlayerView bawaan (exo_buffering). -->

    <!-- Kluster tengah: prev / putar-jeda besar / next -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@id/exo_prev"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/prev_episode"
            android:padding="11dp"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@id/exo_play_pause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="26dp"
            android:background="@drawable/ui_bg_player_button"
            android:contentDescription="@string/play_pause"
            android:padding="16dp"
            android:src="@drawable/ic_play"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@id/exo_next"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next_episode"
            android:padding="11dp"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Bar durasi: pil kaca melayang di bawah (posisi + progres + durasi saja) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/player_pill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/player_text2"
                android:textSize="13sp" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:layout_marginVertical="8dp"
                app:bar_height="4dp"
                app:buffered_color="@color/player_progress_buffered"
                app:played_color="@color/player_progress_played"
                app:unplayed_color="@color/player_progress_unplayed" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/player_text2"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
